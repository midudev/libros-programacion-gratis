---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import BookCard from '../../components/BookCard.astro';
import { isMonochromeLogo, sectionLogoSources } from '../../data/sectionLogos';
import {
	createSectionStructuredData,
	getSectionCanonicalUrl,
	getSectionFaqs,
	getSectionMetaDescription,
	getSectionMetaTitle,
	getSectionPagePath,
	getSectionPageTitle,
	sectionPageEntries,
	siteConfig,
	type SectionPageEntry,
} from '../../data/seo';

export const prerender = true;

export function getStaticPaths() {
	return sectionPageEntries.map((entry) => ({
		params: { slug: entry.pathSlug },
		props: { entry },
	}));
}

const { entry } = Astro.props as { entry: SectionPageEntry };
const { section } = entry;

const title = getSectionMetaTitle(entry);
const pageHeading = getSectionPageTitle(entry);
const description = getSectionMetaDescription(entry);
const structuredData = createSectionStructuredData(entry);
const canonical = getSectionCanonicalUrl(entry);
const sectionFaqs = getSectionFaqs(entry);
const formats = Array.from(new Set(section.books.flatMap((book) => book.formats ?? [])));
const formatsLabel = formats.length > 0 ? formats.join(', ') : 'recursos web';
const formatsList = formats.length > 0 ? formats.join(' · ') : 'Web';
const highlightedBooks = section.books.slice(0, 3).map((book) => book.title);
const highlightedBooksSentence =
	highlightedBooks.length > 0
		? `Para empezar, puedes revisar ${highlightedBooks.join(', ')}${
				section.books.length > highlightedBooks.length ? ' y el resto de recursos de la lista.' : '.'
			}`
		: '';
const heroLogoSources = sectionLogoSources(section.slug);
const relatedEntries = sectionPageEntries
	.filter((related) => related.section.group === section.group && related.section.slug !== section.slug)
	.slice(0, 4);
const plural = (count: number, singular: string, pluralForm: string) =>
	`${count} ${count === 1 ? singular : pluralForm}`;
---

<Layout
	title={title}
	description={description}
	keywords={entry.focusKeywords}
	structuredData={structuredData}
	canonical={canonical}
	image={siteConfig.defaultImage}
	imageAlt={pageHeading}
	dateModified={siteConfig.contentLastModified}
>
	<div class="page">
		<SiteHeader />

		<main>
			<nav class="breadcrumbs" aria-label="Migas de pan">
				<a href="/">Biblioteca</a>
				<span aria-hidden="true">/</span>
				<span>{entry.displayName}</span>
			</nav>

			<section class="page-hero" aria-labelledby="topic-title">
				<div class="animate-fade-in-up animate-duration-700">
					<p class="eyebrow eyebrow--accent">{section.group}</p>
					<h1 id="topic-title">{pageHeading}</h1>
					<p class="page-hero-lead">{entry.intro}</p>
					<ul class="meta-list" aria-label="Resumen de la colección">
						<li><strong>{plural(section.books.length, 'libro', 'libros')}</strong></li>
						<li>{formatsList}</li>
						<li>Gratis y en español</li>
					</ul>
				</div>
				{heroLogoSources.length > 0 && (
					<div class:list={['page-hero-art', heroLogoSources.length > 1 && 'is-logo-pair']} aria-hidden="true">
						{heroLogoSources.map((logo) => (
							<img
								class:list={['section-logo', isMonochromeLogo(logo) && 'section-logo--mono']}
								src={logo}
								alt=""
								width="96"
								height="96"
								loading="eager"
								decoding="async"
							/>
						))}
					</div>
				)}
			</section>

			<section class="section-block" aria-labelledby="books-title">
				<div class="section-head">
					<h2 id="books-title">Libros y guías de {entry.displayName}</h2>
					<span class="topic-count">{plural(section.books.length, 'recurso', 'recursos')}</span>
				</div>

				<div class="book-grid">
					{section.books.map((book) => (
						<BookCard book={book} sectionTitle={section.title} sectionGroup={section.group} />
					))}
				</div>
			</section>

			<section class="prose-section" aria-labelledby="about-topic-title">
				<h2 id="about-topic-title">Aprender {entry.displayName} con libros gratis en español</h2>
				<div class="prose">
					<p>
						Esta página reúne <strong>{section.books.length} libros gratis de {entry.displayName}</strong> en
						español para estudiar {section.description.toLowerCase()} La colección combina recursos en formatos
						{` ${formatsLabel}`}: lectura online, PDF y EPUB cuando están disponibles. Todo el catálogo es
						gratuito y se actualiza desde la biblioteca principal de{' '}
						<a href="/">libros de programación gratis</a>.
					</p>
					{highlightedBooks.length > 0 && <p>{highlightedBooksSentence}</p>}
					<p>
						Si buscas material para principiantes o para profundizar, combina varios recursos según tu nivel.
						También puedes <a href="/contribuir/">proponer un libro gratis de {entry.displayName}</a>
						{' '}si conoces uno en español que aún no está en el listado.
					</p>
				</div>
			</section>

			<section class="prose-section" aria-labelledby="faq-title">
				<h2 id="faq-title">Preguntas frecuentes sobre {entry.displayName}</h2>
				<div class="faq">
					{sectionFaqs.map((faq) => (
						<details>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>

			{relatedEntries.length > 0 && (
				<section class="prose-section" aria-labelledby="related-title">
					<h2 id="related-title">Más libros de {section.group.toLowerCase()}</h2>
					<div class="related-grid">
						{relatedEntries.map((related) => {
							const logo = sectionLogoSources(related.section.slug)[0];
							return (
								<a class="related-card" href={getSectionPagePath(related)}>
									{logo && (
										<img
											class:list={['section-logo', isMonochromeLogo(logo) && 'section-logo--mono']}
											src={logo}
											alt=""
											width="24"
											height="24"
											loading="lazy"
											decoding="async"
										/>
									)}
									<span>
										<strong>{related.displayName}</strong>
										<small>{plural(related.section.books.length, 'libro', 'libros')}</small>
									</span>
								</a>
							);
						})}
					</div>
				</section>
			)}
		</main>

		<SiteFooter showTopics />
	</div>
</Layout>

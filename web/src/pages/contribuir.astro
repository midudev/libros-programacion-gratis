---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Icon from '../components/Icon.astro';
import { allBooks, librarySections, sourceRepository } from '../data/library';

const title = 'Contribuir un libro gratis de programación en español | librosgratis.dev';
const description =
  'Propón un libro o guía gratuita de programación en español sin tocar código. Generamos la issue de GitHub con título, categoría y formato listos para revisar.';
const externalLinkRel = 'nofollow noopener noreferrer';
const categories = librarySections.map((section) => section.title);
const compactCatalog = allBooks.map((book) => ({
  title: book.title,
  href: book.href,
  author: book.author,
  section: book.section,
}));
---

<Layout
  title={title}
  description={description}
  canonical="/contribuir/"
  keywords={[
    'contribuir libros programación gratis',
    'proponer libro programación español',
    'enviar recurso gratis programación',
  ]}
>
  <div class="page contribute-page">
    <SiteHeader />

    <main>
      <nav class="breadcrumbs" aria-label="Migas de pan">
        <a href="/">Biblioteca</a>
        <span aria-hidden="true">/</span>
        <span>Enviar libro</span>
      </nav>

      <section class="page-hero" aria-labelledby="contribute-title">
        <div class="animate-fade-in-up animate-duration-700">
          <p class="eyebrow eyebrow--accent">Contribuir</p>
          <h1 id="contribute-title">Propón un libro <em>gratis</em> para la biblioteca</h1>
          <p class="page-hero-lead">
            ¿Conoces un libro o una guía gratuita de programación en español? Rellena la ficha,
            revisa la vista previa y abre la propuesta en GitHub con todo listo para revisar.
          </p>
          <ul class="meta-list" aria-label="Resumen del proceso">
            <li><strong>3</strong> pasos</li>
            <li>Sin escribir código</li>
            <li>Revisión en GitHub</li>
          </ul>
        </div>
        <div class="page-hero-art" aria-hidden="true">
          <Icon name="books" size={64} strokeWidth={1.25} />
        </div>
      </section>

      <noscript>
        <div class="noscript-note">
          Para generar la propuesta guiada necesitas JavaScript. También puedes abrir una issue manual en
          <a href={`${sourceRepository.href}/issues/new/choose`}>GitHub</a>.
        </div>
      </noscript>

      <section class="contribute-shell" aria-labelledby="proposal-title">
        <form class="proposal-form" data-contribution-form novalidate>
          <div class="form-head">
            <h2 id="proposal-title">Ficha de propuesta</h2>
            <p>Completa lo esencial. Si el libro ya parece estar en el catálogo te avisaremos, pero puedes seguir.</p>
          </div>

          <fieldset class="proposal-step">
            <legend><span>1</span> Enlace del recurso</legend>
            <label for="resource-url">URL del libro, guía o PDF</label>
            <input id="resource-url" name="url" type="url" inputmode="url" placeholder="https://ejemplo.com/libro-gratis.pdf" required aria-describedby="url-help" />
            <p class="field-help" id="url-help" data-url-status>Pega una URL http o https. No hacemos comprobaciones remotas.</p>
            <div class="duplicate-warning" data-duplicate-warning hidden aria-live="polite"></div>
          </fieldset>

          <fieldset class="proposal-step">
            <legend><span>2</span> Datos del libro</legend>
            <div class="field-grid">
              <div class="field-card">
                <label for="resource-title">Título</label>
                <input id="resource-title" name="title" type="text" autocomplete="off" required />
              </div>
              <div class="field-card">
                <label for="resource-author">Autor o proyecto</label>
                <input id="resource-author" name="author" type="text" placeholder="Autoría, editorial o comunidad" />
              </div>
            </div>
            <div class="field-grid">
              <div class="field-card">
                <label for="resource-category">Categoría sugerida</label>
                <div class="select-wrap">
                  <select id="resource-category" name="category" required>
                    <option value="">Elige una categoría</option>
                    {categories.map((category) => <option value={category}>{category}</option>)}
                  </select>
                </div>
              </div>
              <div class="field-card">
                <label for="resource-format">Formato</label>
                <div class="select-wrap">
                  <select id="resource-format" name="format" required>
                    <option value="">Elige formato</option>
                    <option>PDF</option>
                    <option>HTML</option>
                    <option>ePub</option>
                    <option>Mobi</option>
                    <option>Otro</option>
                  </select>
                </div>
              </div>
            </div>
          </fieldset>

          <fieldset class="proposal-step">
            <legend><span>3</span> Confirmación y nota</legend>
            <label class="check-card">
              <input name="isFree" type="checkbox" required />
              <span><strong>Es gratuito</strong> Sin paywall, registro obligatorio ni versión trial.</span>
            </label>
            <label class="check-card">
              <input name="isSpanish" type="checkbox" required />
              <span><strong>Está en español</strong> Escrito o traducido al español.</span>
            </label>
            <div class="field-card note-card">
              <label for="resource-note">Por qué debería estar en el catálogo <small>opcional, máx. 500</small></label>
              <textarea id="resource-note" name="note" maxlength="500" rows="5" placeholder="Nivel, enfoque, ejercicios o por qué te parece útil."></textarea>
              <p class="field-help"><span data-note-count>0</span> / 500</p>
            </div>
          </fieldset>

          <div class="form-actions">
            <p class="status-line" data-form-status aria-live="polite">Faltan campos obligatorios para crear la issue.</p>
            <button class="btn" type="button" data-copy-proposal>
              <Icon name="copy" />
              <span>Copiar propuesta</span>
            </button>
            <a class="btn btn-primary is-disabled" data-create-issue href={sourceRepository.href} aria-disabled="true" tabindex="-1" role="button">
              <Icon name="github" />
              <span>Crear issue en GitHub</span>
            </a>
          </div>
        </form>

        <aside class="proposal-preview" aria-label="Vista previa">
          <section class="preview-card">
            <p class="card-label">Así se verá en el catálogo</p>
            <h3 class="preview-title" data-preview-title>Tu título aparecerá aquí</h3>
            <p class="book-author" data-preview-author>Autor o proyecto</p>
            <div class="preview-formats"><span data-preview-category>Categoría</span><span data-preview-format>Formato</span><span>Gratis</span></div>
            <p class="preview-note" data-preview-note>Tu nota ayudará a revisar el recurso.</p>
          </section>
          <section class="issue-preview">
            <p class="card-label">Texto de la issue</p>
            <strong data-issue-title>[nuevo-libro] Nuevo recurso gratuito</strong>
            <pre data-issue-body>Completa el formulario para ver la propuesta.</pre>
          </section>
        </aside>
      </section>

      <section class="prose-section" aria-labelledby="how-it-works-title">
        <h2 id="how-it-works-title">Proponer recursos gratuitos sin tocar el catálogo</h2>
        <div class="prose">
          <p>
            Esta página prepara una propuesta con los datos mínimos que revisa el equipo:
            enlace, título, categoría, formato y confirmación de que el recurso es gratis y está en español.
          </p>
          <p>
            GitHub mostrará tu usuario en la propuesta. Si no quieres iniciar sesión todavía,
            puedes copiar el texto completo y guardarlo para después.
          </p>
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>

  <script type="application/json" id="contribution-data" set:html={JSON.stringify({ compactCatalog, repositoryHref: sourceRepository.href }).replace(/</g, '\\u003c')} />

  <script>
    import { buildIssueBody, buildIssueTitle, buildIssueUrl, createSearchableCatalog, findPotentialDuplicates, isSupportedUrl } from '../lib/contribution';

    const pageData = JSON.parse(document.querySelector('#contribution-data')?.textContent || '{}');
    const searchableCatalog = createSearchableCatalog(pageData.compactCatalog || []);
    const repositoryHref = pageData.repositoryHref || '';
    const form = document.querySelector('[data-contribution-form]');
    const createIssue = document.querySelector('[data-create-issue]');
    const copyButton = document.querySelector('[data-copy-proposal]');
    const formStatus = document.querySelector('[data-form-status]');
    const urlStatus = document.querySelector('[data-url-status]');
    const duplicateWarning = document.querySelector('[data-duplicate-warning]');
    const noteCount = document.querySelector('[data-note-count]');
    const previewTitle = document.querySelector('[data-preview-title]');
    const previewAuthor = document.querySelector('[data-preview-author]');
    const previewCategory = document.querySelector('[data-preview-category]');
    const previewFormat = document.querySelector('[data-preview-format]');
    const previewNote = document.querySelector('[data-preview-note]');
    const issueTitle = document.querySelector('[data-issue-title]');
    const issueBody = document.querySelector('[data-issue-body]');

    const getFormData = () => {
      const data = new FormData(form);

      return {
        url: String(data.get('url') ?? '').trim(),
        title: String(data.get('title') ?? '').trim(),
        author: String(data.get('author') ?? '').trim(),
        category: String(data.get('category') ?? ''),
        format: String(data.get('format') ?? ''),
        note: String(data.get('note') ?? '').trim(),
        isFree: data.get('isFree') === 'on',
        isSpanish: data.get('isSpanish') === 'on',
      };
    };

    const getMissingFields = (data) => {
      const missing = [];

      if (!data.url) missing.push('URL');
      if (data.url && !isSupportedUrl(data.url)) missing.push('URL válida');
      if (!data.title) missing.push('título');
      if (!data.category) missing.push('categoría');
      if (!data.format) missing.push('formato');
      if (!data.isFree) missing.push('confirmar que es gratuito');
      if (!data.isSpanish) missing.push('confirmar que está en español');

      return missing;
    };

    const update = () => {
      const data = getFormData();
      const missing = getMissingFields(data);
      const valid = missing.length === 0;
      const body = buildIssueBody(data);
      const title = buildIssueTitle(data);
      const duplicates = findPotentialDuplicates(data, searchableCatalog);

      previewTitle.textContent = data.title || 'Tu título aparecerá aquí';
      previewAuthor.textContent = data.author || 'Autor o proyecto';
      previewCategory.textContent = data.category || 'Categoría';
      previewFormat.textContent = data.format || 'Formato';
      previewNote.textContent = data.note || 'Tu nota ayudará a revisar el recurso.';
      issueTitle.textContent = title;
      issueBody.textContent = body;
      noteCount.textContent = String(data.note.length);

      if (!data.url) {
        urlStatus.textContent = 'Pega una URL http o https. No hacemos comprobaciones remotas.';
        urlStatus.dataset.state = '';
      } else if (isSupportedUrl(data.url)) {
        urlStatus.textContent = 'URL con formato válido.';
        urlStatus.dataset.state = 'ok';
      } else {
        urlStatus.textContent = 'Usa una URL válida que empiece con http o https.';
        urlStatus.dataset.state = 'error';
      }

      duplicateWarning.hidden = duplicates.length === 0;
      if (duplicates.length > 0) {
        duplicateWarning.textContent = `Puede que ya exista: ${duplicates.map((entry) => `${entry.title} (${entry.section})`).join(', ')}. Si es otra edición o traducción, continúa.`;
      }

      if (valid) {
        createIssue.href = buildIssueUrl(repositoryHref, data);
        createIssue.classList.remove('is-disabled');
        createIssue.setAttribute('aria-disabled', 'false');
        createIssue.removeAttribute('tabindex');
        formStatus.textContent = 'Propuesta lista para abrir en GitHub.';
      } else {
        createIssue.href = repositoryHref;
        createIssue.classList.add('is-disabled');
        createIssue.setAttribute('aria-disabled', 'true');
        createIssue.setAttribute('tabindex', '-1');
        formStatus.textContent = `Falta: ${missing.join(', ')}.`;
      }

      copyButton.dataset.proposal = body;
    };

    form.addEventListener('input', update);
    form.addEventListener('change', update);
    createIssue.addEventListener('click', (event) => {
      if (createIssue.getAttribute('aria-disabled') === 'true') {
        event.preventDefault();
      }
    });
    copyButton.addEventListener('click', async () => {
      const proposal = copyButton.dataset.proposal || issueBody.textContent || '';

      try {
        await navigator.clipboard.writeText(proposal);
        form.querySelector('.copy-fallback')?.remove();
        formStatus.textContent = 'Propuesta copiada al portapapeles.';
      } catch {
        const fallback = form.querySelector('.copy-fallback') || document.createElement('textarea');
        fallback.className = 'copy-fallback';
        fallback.value = proposal;
        fallback.readOnly = true;
        if (!fallback.isConnected) {
          copyButton.insertAdjacentElement('afterend', fallback);
        }
        fallback.focus();
        fallback.select();
        formStatus.textContent = 'No se pudo copiar automáticamente. Selecciona el texto mostrado.';
      }
    });

    update();
  </script>
</Layout>

<style>
  .contribute-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(17rem, 21rem);
    align-items: start;
    gap: 1.5rem;
    padding: clamp(2rem, 5vw, 2.75rem) 0;
  }

  .proposal-form {
    overflow: clip;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .form-head {
    padding: 1.35rem 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .form-head h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.15;
  }

  .form-head p,
  .field-help,
  .status-line {
    margin: 0;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .form-head p {
    margin-top: 0.35rem;
  }

  fieldset {
    display: grid;
    gap: 1rem;
    min-width: 0;
    margin: 0;
    padding: 1.5rem;
    border: 0;
    border-bottom: 1px solid var(--line);
  }

  /* float convierte la leyenda en un elemento más del grid */
  legend {
    float: left;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    margin: 0;
    padding: 0;
    color: var(--ink);
    font-size: 1rem;
    font-weight: 600;
  }

  legend span {
    display: inline-grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
  }

  label {
    display: grid;
    gap: 0.4rem;
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 500;
  }

  label small {
    margin-left: 0.35rem;
    color: var(--muted);
    font-weight: 400;
  }

  /* Etiqueta y campo sueltos dentro del fieldset: los acercamos */
  fieldset > label:not(.check-card) + input {
    margin-top: -0.6rem;
  }

  fieldset > input + .field-help {
    margin-top: -0.5rem;
  }

  .note-card label {
    display: block;
  }

  .field-card {
    display: grid;
    gap: 0.4rem;
  }

  .field-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  input,
  select,
  textarea {
    width: 100%;
    min-height: 44px;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--paper);
    color: var(--ink);
    font-size: 0.9375rem;
    transition:
      border-color 150ms ease,
      box-shadow 150ms ease;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--muted);
    opacity: 1;
  }

  input:hover,
  select:hover,
  textarea:hover {
    border-color: var(--muted);
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    border-color: var(--accent);
    outline: none;
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  select {
    padding-right: 2.25rem;
    appearance: none;
    cursor: pointer;
  }

  .select-wrap {
    position: relative;
  }

  .select-wrap::after {
    content: '';
    position: absolute;
    top: 50%;
    right: 0.75rem;
    width: 16px;
    height: 16px;
    background: var(--muted);
    mask: url('../icons/chevron-down.svg') center / contain no-repeat;
    pointer-events: none;
    translate: 0 -50%;
  }

  textarea {
    resize: vertical;
  }

  .check-card {
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    font-weight: 400;
    cursor: pointer;
    transition:
      border-color 150ms ease,
      background-color 150ms ease;
  }

  .check-card:hover {
    border-color: var(--line-strong);
  }

  .check-card:has(input:checked) {
    border-color: color-mix(in srgb, var(--ok) 45%, transparent);
    background: color-mix(in srgb, var(--ok) 7%, var(--paper));
  }

  .check-card input {
    width: 1.1rem;
    height: 1.1rem;
    min-height: 0;
    margin: 0.15rem 0 0;
    padding: 0;
    accent-color: var(--ok);
    cursor: pointer;
  }

  .check-card span {
    color: var(--muted);
  }

  .check-card strong {
    display: block;
    color: var(--ink);
    font-weight: 500;
  }

  .noscript-note,
  .duplicate-warning {
    padding: 0.75rem 1rem;
    border: 1px solid color-mix(in srgb, var(--warn) 40%, transparent);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--warn) 8%, transparent);
    color: var(--ink-soft);
    font-size: 0.875rem;
  }

  .noscript-note {
    margin-top: 1.5rem;
  }

  .form-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    padding: 1.25rem 1.5rem;
    background: var(--surface);
  }

  .status-line {
    flex: 1 1 100%;
  }

  .copy-fallback {
    flex: 1 1 100%;
    min-height: 8rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .proposal-preview {
    position: sticky;
    top: 1.5rem;
    display: grid;
    gap: 0.75rem;
    min-width: 0;
  }

  .preview-card,
  .issue-preview {
    padding: 1.1rem 1.15rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .card-label {
    margin: 0 0 0.75rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .preview-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .preview-formats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.85rem;
  }

  .preview-formats span {
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .preview-note {
    margin: 0.85rem 0 0;
    padding-top: 0.85rem;
    border-top: 1px dashed var(--line);
    color: var(--muted);
    font-size: 0.8125rem;
    font-style: italic;
    line-height: 1.45;
  }

  .issue-preview strong {
    display: block;
    margin-bottom: 0.6rem;
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .issue-preview pre {
    max-height: 22rem;
    margin: 0;
    padding: 0.75rem;
    overflow: auto;
    border-radius: var(--radius-sm);
    background: var(--paper-sunk);
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.55;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  [data-state='ok'] {
    color: var(--ok);
  }

  [data-state='error'] {
    color: var(--danger);
  }

  @media (max-width: 860px) {
    .contribute-shell {
      grid-template-columns: minmax(0, 1fr);
    }

    .proposal-preview {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .field-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    fieldset,
    .form-head,
    .form-actions {
      padding-inline: 1rem;
    }

    .form-actions {
      position: sticky;
      bottom: 0;
      z-index: 5;
      border-top: 1px solid var(--line);
    }

    .form-actions :global(.btn) {
      flex: 1 1 100%;
    }
  }
</style>

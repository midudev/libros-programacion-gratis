---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import {
	getLocalPdfBook,
	librarySections,
	sourceRepository,
	totalBooks,
	totalSections,
} from '../data/library';
import {
	createHomeStructuredData,
	getSectionPageEntry,
	getSectionPagePath,
	homeFaqs,
	homeMeta,
	siteConfig,
} from '../data/seo';
import { isMonochromeLogo, sectionLogoSources } from '../data/sectionLogos';

const sectionEntries = librarySections.map(getSectionPageEntry);
const topTopics = sectionEntries
	.filter((entry) => entry.section.books.length > 0)
	.slice(0, 12);

const externalLinkRel = 'nofollow noreferrer';
const isExternalHref = (href: string) => /^https?:\/\//.test(href);
const bookLinkRel = (href: string) =>
	isExternalHref(href) ? externalLinkRel : undefined;

const structuredData = createHomeStructuredData();
---

<Layout
	title={homeMeta.title}
	description={homeMeta.description}
	keywords={homeMeta.keywords}
	structuredData={structuredData}
	canonical="/"
	image={siteConfig.defaultImage}
	imageAlt={siteConfig.defaultImageAlt}
>
	<div class="page">
		<header class="header animate-fade-in animate-duration-500">
			<a class="logo" href="/" aria-label="Inicio" data-tooltip="Inicio" title="Inicio">
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
					<path d="M5 5a1 1 0 0 1 1 -1h2a1 1 0 0 1 1 1v14a1 1 0 0 1 -1 1h-2a1 1 0 0 1 -1 -1l0 -14" />
					<path d="M9 5a1 1 0 0 1 1 -1h2a1 1 0 0 1 1 1v14a1 1 0 0 1 -1 1h-2a1 1 0 0 1 -1 -1l0 -14" />
					<path d="M5 8h4" /><path d="M9 16h4" />
					<path d="M13.803 4.56l2.184 -.53c.562 -.135 1.133 .19 1.282 .732l3.695 13.418a1.02 1.02 0 0 1 -.634 1.219l-.133 .041l-2.184 .53c-.562 .135 -1.133 -.19 -1.282 -.732l-3.695 -13.418a1.02 1.02 0 0 1 .634 -1.219l.133 -.041" />
					<path d="M14 9l4 -1" /><path d="M16 16l3.923 -.98" />
				</svg>
			</a>
			<nav class="header-nav" aria-label="Principal">
				<a class="header-link" href="#" id="show-favorites" aria-label="Ver libros favoritos">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
					</svg>
					<span>Favoritos</span>
					<span class="favorites-count" id="favorites-count">0</span>
				</a>
				<a class="header-link" href={sourceRepository.href} target="_blank" rel={externalLinkRel}>
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3" />
						<path d="M15 21v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
					</svg>
					<span>GitHub</span>
				</a>
				<ThemeToggle />
				<a class="header-cta" href="/contribuir/">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M5 19.5v-14a2.5 2.5 0 0 1 2.5 -2.5h10.5v18h-10.5a2.5 2.5 0 0 1 0 -5h10.5" />
						<path d="M9 8h5" />
						<path d="M9 11h4" />
					</svg>
					<span>Enviar libro</span>
				</a>
			</nav>
		</header>

		<main>
			<section class="hero hero-home" aria-labelledby="hero-title">
				<div class="hero-glow" aria-hidden="true"></div>

				<h1 id="hero-title" class="animate-blurred-fade-in animate-duration-800">
					Libros <em>gratis</em> de programación en español
				</h1>

				<p class="hero-sub animate-fade-in-up animate-delay-150 animate-duration-700">
					Descubre, lee online y descarga recursos curados en tu idioma.
					JavaScript, Python, TypeScript, Rust, React y mucho más.
				</p>

				<ul class="hero-stats animate-fade-in-up animate-delay-250 animate-duration-700" aria-label="Resumen del catálogo">
					<li>
						<strong>{totalBooks}</strong>
						<span>libros</span>
					</li>
					<li>
						<strong>{totalSections}</strong>
						<span>temas</span>
					</li>
					<li>
						<strong>PDF</strong>
						<span>y HTML</span>
					</li>
					<li>
						<strong>0&nbsp;€</strong>
						<span>siempre</span>
					</li>
				</ul>

				<div class="hero-search-wrap animate-fade-in-up animate-delay-300 animate-duration-700" data-hero-search>
					<label class="search-control search-control-hero" for="library-search">
						<span class="search-control-icon" aria-hidden="true">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
								<path d="M10 18a8 8 0 1 1 5.657 -13.657A8 8 0 0 1 10 18z" />
								<path d="M21 21l-5.35 -5.35" />
							</svg>
						</span>
						<input
							id="library-search"
							class="search-input"
							type="search"
							placeholder="Buscar por título, autor, lenguaje o tema…"
							autocomplete="off"
							enterkeyhint="search"
						/>
						<span class="search-control-aside">
							<span class="search-results-inline" aria-live="polite">
								<strong data-results-count>{totalBooks}</strong>
							</span>
							<button class="reset-btn search-reset" type="button" data-reset-search hidden>
								Limpiar
							</button>
							<kbd class="search-hotkey" title="Pulsa / para buscar" aria-hidden="true">/</kbd>
						</span>
					</label>
				</div>

				<div class="hero-topics animate-fade-in-up animate-delay-400 animate-duration-700" data-hero-topics>
					<p class="hero-topics-label" id="topics-label">Explorar por tema</p>
					<nav class="language-dock" aria-labelledby="topics-label">
						{
							sectionEntries.map((entry) => {
								const logoSources = sectionLogoSources(entry.section.slug);

								return (
									<a
										class:list={['language-dock-link', logoSources.length > 1 && 'is-logo-pair']}
										href={`#${entry.section.slug}`}
										aria-label={`Ir a ${entry.section.title}`}
										data-tooltip={entry.section.title}
										title={entry.section.title}
									>
										<span class="language-dock-logo-stack" aria-hidden="true">
											{logoSources.map((logo) => (
												<img
													class:list={['section-logo', isMonochromeLogo(logo) && 'section-logo--mono']}
													src={logo}
													alt=""
													width="28"
													height="28"
													loading="lazy"
													decoding="async"
												/>
											))}
										</span>
									</a>
								);
							})
						}
					</nav>
				</div>
			</section>

			<section class="library" id="biblioteca" aria-labelledby="library-title">
				<h2 id="library-title" class="sr-only">Biblioteca</h2>

				<div class="toolbar toolbar-sticky" data-sticky-toolbar hidden>
					<label class="search-control search-control-compact" for="library-search-sticky">
						<span class="search-control-icon" aria-hidden="true">
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
								<path d="M10 18a8 8 0 1 1 5.657 -13.657A8 8 0 0 1 10 18z" />
								<path d="M21 21l-5.35 -5.35" />
							</svg>
						</span>
						<input
							id="library-search-sticky"
							class="search-input"
							type="search"
							placeholder="Buscar en la biblioteca…"
							autocomplete="off"
							aria-label="Buscar en la biblioteca"
						/>
						<span class="search-control-aside">
							<span class="search-results-inline" aria-live="polite">
								<strong data-results-count-sticky>{totalBooks}</strong>
							</span>
							<button class="reset-btn search-reset" type="button" data-reset-search-sticky hidden>
								Limpiar
							</button>
						</span>
					</label>
				</div>

				{
					sectionEntries.map((entry) => {
						const section = entry.section;

						return (
							<section
								class="topic animate-fade-in-up timeline-view animate-range-[entry_10%_contain_20%]"
								id={section.slug}
								data-group={section.group}
								data-section={section.title}
								aria-labelledby={`${section.slug}-title`}
							>
								<div class="topic-header">
									<h2 id={`${section.slug}-title`}>
										<span class="topic-logo-stack" aria-hidden="true">
											{sectionLogoSources(section.slug).map((logo) => (
												<img
													class:list={['topic-logo', 'section-logo', isMonochromeLogo(logo) && 'section-logo--mono']}
													src={logo}
													alt=""
													width="22"
													height="22"
													loading="lazy"
												/>
											))}
										</span>
										{section.title}
										<a
											class="topic-title-link"
											href={getSectionPagePath(entry)}
											aria-label={`Ver libros gratis de ${entry.displayName}`}
											data-tooltip={`Ver página de ${entry.displayName}`}
											title={`Ver página de ${entry.displayName}`}
										>
											<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
												<path d="M7 17L17 7" />
												<path d="M8 7h9v9" />
											</svg>
										</a>
									</h2>
									<span class="topic-count">
										{section.books.length} {section.books.length === 1 ? 'libro' : 'libros'}
									</span>
								</div>
								<p class="topic-desc">{section.description}</p>

								<div class="book-grid">
									{section.books.map((book) => {
										const pdfBook = getLocalPdfBook(book);
										const hasHtmlVersion = Boolean(pdfBook && pdfBook.href !== pdfBook.pdfHref);
										const primaryHref = hasHtmlVersion
											? book.href
											: (pdfBook?.readerPath ?? book.href);
										const opensInNewTab = isExternalHref(primaryHref);
										const formats = pdfBook?.formats ?? book.formats ?? [];
										const canOpen = Boolean(primaryHref);

										return (
											<article
												class:list={['book', pdfBook && 'is-pdf', !canOpen && 'is-static']}
												data-search={`${book.title} ${book.author ?? ''} ${section.title} ${section.group}`.toLowerCase()}
											>
												{canOpen && (
													<a
														class="book-card-link"
														href={primaryHref}
														target={opensInNewTab ? '_blank' : undefined}
														rel={bookLinkRel(primaryHref)}
														aria-label={`Abrir ${book.title}`}
													></a>
												)}

												<button
													class="book-fav"
													type="button"
													data-favorite="false"
													data-book-id={book.id}
													aria-label="Marcar como favorito"
													data-tooltip="Favorito"
													title="Favorito"
												>
													<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
														<path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
													</svg>
												</button>

												<div class="book-body">
													<h3>{book.title}</h3>
													{book.author && <p class="book-author">{book.author}</p>}
												</div>

												<div class="book-meta">
													{formats.length > 0 && (
														<div class="book-formats" aria-label="Formatos disponibles">
															{formats.map((format) => (
																<span class="book-format">{format}</span>
															))}
														</div>
													)}

													<div class="book-actions" aria-label={`Acciones para ${book.title}`}>
														{hasHtmlVersion && (
															<a class="book-icon-btn" href={book.href} target={isExternalHref(book.href) ? '_blank' : undefined} rel={bookLinkRel(book.href)} aria-label={`Leer HTML de ${book.title}`} data-tooltip="Leer HTML" title="Leer HTML">
																<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
																	<path d="M4 19a2 2 0 0 0 2 2h12" />
																	<path d="M6 17a2 2 0 0 0 -2 2v-14a2 2 0 0 1 2 -2h12v18" />
																	<path d="M8 7h6" />
																</svg>
															</a>
														)}
														{pdfBook && (
															<>
																<a class="book-icon-btn" href={pdfBook.readerPath} aria-label={`Leer PDF de ${book.title}`} data-tooltip="Leer PDF" title="Leer PDF">
																	<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
																		<path d="M14 3v4a1 1 0 0 0 1 1h4" />
																		<path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z" />
																		<path d="M9 15h6" />
																		<path d="M9 18h3" />
																	</svg>
																</a>
																<a class="book-icon-btn" href={pdfBook.downloadPath} aria-label={`Descargar ${book.title}`} data-tooltip="Descargar" title="Descargar">
																	<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
																		<path d="M12 3v12" />
																		<path d="M7 10l5 5l5 -5" />
																		<path d="M5 21h14" />
																	</svg>
																</a>
															</>
														)}
														{!pdfBook && opensInNewTab && (
															<a class="book-icon-btn" href={primaryHref} target="_blank" rel={bookLinkRel(primaryHref)} aria-label={`Abrir sitio de ${book.title}`} data-tooltip="Abrir web" title="Abrir web">
																<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
																	<path d="M7 17L17 7" />
																	<path d="M8 7h9v9" />
																</svg>
															</a>
														)}
													</div>
												</div>
											</article>
										);
									})}
								</div>
							</section>
						);
					})
				}

				<div class="empty-state animate-fade-in" hidden data-empty-state>
					<p>No hay coincidencias con esa búsqueda. Prueba con otro término.</p>
				</div>
			</section>

			<section class="seo-copy" aria-labelledby="about-library-title">
				<h2 id="about-library-title">Biblioteca de libros de programación gratis en español</h2>
				<p>
					{siteConfig.name} reúne {totalBooks} recursos gratuitos de programación en español,
					organizados en {totalSections} temas: lenguajes, frameworks, bases de datos, herramientas
					y fundamentos. El objetivo es que puedas <strong>aprender a programar gratis</strong> con
					material en tu idioma, sin registros ni paywalls.
				</p>
				<p>
					Explora colecciones como{' '}
					{topTopics.map((entry, index) => (
						<>
							{index > 0 && (index === topTopics.length - 1 ? ' o ' : ', ')}
							<a href={getSectionPagePath(entry)}>libros gratis de {entry.displayName}</a>
						</>
					))}
					. Muchos títulos incluyen lectura online y descarga en PDF o EPUB.
				</p>
			</section>

			<section class="seo-faq" aria-labelledby="home-faq-title">
				<h2 id="home-faq-title">Preguntas frecuentes</h2>
				{homeFaqs.map((faq) => (
					<details>
						<summary>{faq.question}</summary>
						<p>{faq.answer}</p>
					</details>
				))}
			</section>

			<div class="favorites-panel" id="favorites-panel" hidden>
				<div class="favorites-header">
					<h2>Libros Favoritos</h2>
					<button class="favorites-close" type="button" aria-label="Cerrar panel de favoritos" data-tooltip="Cerrar" title="Cerrar">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M18 6L6 18" />
							<path d="M6 6l12 12" />
						</svg>
					</button>
				</div>
				<div class="favorites-list" id="favorites-list">
					<p class="favorites-empty" hidden>No tienes libros favoritos aún. Haz clic en el corazón de cualquier libro para agregarlo.</p>
				</div>
			</div>
		</main>

		<footer class="footer">
			<nav class="footer-topic-links" aria-label="Páginas de libros por tema">
				{
					sectionEntries.map((entry) => (
						<a href={getSectionPagePath(entry)}>Libros gratis de {entry.displayName}</a>
					))
				}
			</nav>
			<div class="footer-meta">
				<p>
					Contenido del repositorio{' '}
					<a href={sourceRepository.href} target="_blank" rel={externalLinkRel}>
						{sourceRepository.name}
					</a>
				</p>
				<button class="footer-share" type="button" data-share-trigger>Compartir</button>
			</div>
		</footer>
	</div>

	<script is:inline>
		const searchInput = document.querySelector('#library-search');
		const stickySearchInput = document.querySelector('#library-search-sticky');
		const resetButton = document.querySelector('[data-reset-search]');
		const stickyResetButton = document.querySelector('[data-reset-search-sticky]');
		const resultsCount = document.querySelector('[data-results-count]');
		const stickyResultsCount = document.querySelector('[data-results-count-sticky]');
		const emptyState = document.querySelector('[data-empty-state]');
		const sectionBlocks = Array.from(document.querySelectorAll('.topic'));
		const shareButtons = Array.from(document.querySelectorAll('[data-share-trigger]'));
		const stickyToolbar = document.querySelector('[data-sticky-toolbar]');
		const heroTopics = document.querySelector('[data-hero-topics]');
		const pageRoot = document.querySelector('.page');
		const librarySection = document.querySelector('#biblioteca');

		const getSearchValue = () => (searchInput?.value ?? stickySearchInput?.value ?? '').trim();

		const setSearchValue = (value, source) => {
			if (searchInput && source !== searchInput) searchInput.value = value;
			if (stickySearchInput && source !== stickySearchInput) stickySearchInput.value = value;
		};

		const syncQueryToUrl = () => {
			const query = getSearchValue();
			const url = new URL(window.location.href);
			if (query) {
				url.searchParams.set('q', query);
			} else {
				url.searchParams.delete('q');
			}
			const next = `${url.pathname}${url.search}${url.hash}`;
			const current = `${window.location.pathname}${window.location.search}${window.location.hash}`;
			if (next !== current) {
				window.history.replaceState({}, '', next);
			}
		};

		const applyFilters = () => {
			const rawQuery = getSearchValue();
			const query = rawQuery.toLowerCase();
			const hasQuery = query !== '';
			let visibleBooks = 0;

			// Al buscar: oculta el dock de temas y compacta el hero para ver resultados debajo
			pageRoot?.classList.toggle('is-searching', hasQuery);
			heroTopics?.toggleAttribute('hidden', hasQuery);

			sectionBlocks.forEach((section) => {
				let sectionVisibleBooks = 0;

				section.querySelectorAll('.book').forEach((card) => {
					const haystack = card.getAttribute('data-search') ?? '';
					const matchesSearch = !hasQuery || haystack.includes(query);

					card.toggleAttribute('hidden', !matchesSearch);
					if (matchesSearch) {
						sectionVisibleBooks += 1;
						visibleBooks += 1;
					}
				});

				section.toggleAttribute('hidden', sectionVisibleBooks === 0);
			});

			const countText = String(visibleBooks);
			if (resultsCount) resultsCount.textContent = countText;
			if (stickyResultsCount) stickyResultsCount.textContent = countText;

			if (emptyState) {
				emptyState.toggleAttribute('hidden', visibleBooks !== 0);
			}

			resetButton?.toggleAttribute('hidden', !hasQuery);
			stickyResetButton?.toggleAttribute('hidden', !hasQuery);

			syncQueryToUrl();
		};

		const onSearchInput = (event) => {
			const target = event.currentTarget;
			setSearchValue(target?.value ?? '', target);
			applyFilters();
		};

		searchInput?.addEventListener('input', onSearchInput);
		stickySearchInput?.addEventListener('input', onSearchInput);

		const clearSearch = (focusEl) => {
			setSearchValue('', null);
			if (searchInput) searchInput.value = '';
			if (stickySearchInput) stickySearchInput.value = '';
			focusEl?.focus();
			applyFilters();
		};

		resetButton?.addEventListener('click', () => clearSearch(searchInput));
		stickyResetButton?.addEventListener('click', () => clearSearch(stickySearchInput));

		// Atajo "/" para enfocar la búsqueda (estilo docs)
		document.addEventListener('keydown', (event) => {
			if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;
			const tag = (event.target instanceof HTMLElement ? event.target.tagName : '').toLowerCase();
			if (tag === 'input' || tag === 'textarea' || event.target?.isContentEditable) return;
			event.preventDefault();
			const heroVisible = searchInput && searchInput.getBoundingClientRect().bottom > 80;
			(heroVisible ? searchInput : stickySearchInput ?? searchInput)?.focus();
		});

		shareButtons.forEach((button) => {
			button.dataset.label = button.textContent?.trim() ?? 'Compartir';

			button.addEventListener('click', async () => {
				const shareData = {
					title: document.title,
					text: 'Libros gratis de programación en español, organizados por tema.',
					url: window.location.href,
				};

				try {
					if (navigator.share) {
						await navigator.share(shareData);
						return;
					}

					await navigator.clipboard.writeText(shareData.url);
					button.textContent = 'Enlace copiado';
					window.setTimeout(() => {
						button.textContent = button.dataset.label ?? 'Compartir';
					}, 1800);
				} catch (error) {
					console.error(error);
				}
			});
		});

		// Soporta SearchAction de Google: /?q=término
		const initialQuery = new URLSearchParams(window.location.search).get('q');
		if (initialQuery) {
			setSearchValue(initialQuery, null);
			if (searchInput) searchInput.value = initialQuery;
			if (stickySearchInput) stickySearchInput.value = initialQuery;
		}

		// Barra fija arriba solo cuando el buscador del hero sale de pantalla
		const heroSearch = document.querySelector('[data-hero-search]');
		if (stickyToolbar && heroSearch && 'IntersectionObserver' in window) {
			const io = new IntersectionObserver(
				([entry]) => {
					const showSticky = !entry.isIntersecting;
					stickyToolbar.toggleAttribute('hidden', !showSticky);
					document.documentElement.classList.toggle('has-sticky-search', showSticky);
				},
				{ root: null, rootMargin: '0px', threshold: 0 },
			);
			io.observe(heroSearch);
		} else if (stickyToolbar) {
			stickyToolbar.setAttribute('hidden', '');
		}

		applyFilters();
	</script>
	<script>
		import { getFavorites, toggleFavorite } from '../scripts/favorites.ts';

		const showFavoritesBtn = document.querySelector('#show-favorites');
		const favoritesPanel = document.querySelector('#favorites-panel');
		const favoritesList = document.querySelector('#favorites-list');
		const favoritesEmpty = favoritesPanel?.querySelector('.favorites-empty');
		const favoritesClose = favoritesPanel?.querySelector('.favorites-close');
		const favoritesCount = document.querySelector('#favorites-count');

		const updateFavoritesCount = () => {
			if (!favoritesCount) return;
			const count = getFavorites().length;
			favoritesCount.textContent = count.toString();
			favoritesCount.setAttribute('data-count', count.toString());
		};

		const bookLookup = new Map();
		document.querySelectorAll('.book').forEach((card) => {
			const favBtn = card.querySelector('[data-book-id]');
			if (!favBtn) return;
			const bookId = favBtn.getAttribute('data-book-id');
			if (!bookId) return;
			const title = card.querySelector('h3')?.textContent?.trim() ?? '';
			const author = card.querySelector('.book-author')?.textContent?.trim() ?? '';
			const cardLink = card.querySelector('.book-card-link');
			const href = cardLink?.getAttribute('href') ?? '';
			bookLookup.set(bookId, { title, author, href });
		});

		const syncFavoritesUI = () => {
			const favs = getFavorites();
			document.querySelectorAll('[data-favorite]').forEach((btn) => {
				const bookId = btn.getAttribute('data-book-id');
				if (!bookId) return;
				const isFav = favs.includes(bookId);
				btn.setAttribute('data-favorite', isFav.toString());
				const favLabel = isFav ? 'Quitar de favoritos' : 'Marcar como favorito';
				btn.setAttribute('aria-label', favLabel);
				btn.setAttribute('data-tooltip', isFav ? 'Quitar favorito' : 'Favorito');
				btn.setAttribute('title', isFav ? 'Quitar favorito' : 'Favorito');
			});
		};

		const renderFavoritesPanel = () => {
			if (!favoritesList || !favoritesEmpty) return;
			const favorites = getFavorites();

			while (favoritesList.children.length > 1) {
				favoritesList.lastChild?.remove();
			}
			favoritesList.innerHTML = '';
			favoritesList.appendChild(favoritesEmpty);

			if (favorites.length === 0) {
				favoritesEmpty.removeAttribute('hidden');
				return;
			}

			favoritesEmpty.setAttribute('hidden', '');

			favorites.forEach((bookId) => {
				const book = bookLookup.get(bookId);
				if (!book) return;

				const isExternal = book.href && /^https?:\/\//.test(book.href);
				const item = document.createElement('div');
				item.className = 'favorites-item animate-fade-in-right animate-duration-400';
				item.innerHTML = [
					'<div style="flex:1">',
					book.href
						? `<a class="favorites-item-title" href="${book.href}" ${isExternal ? 'target="_blank" rel="nofollow noreferrer"' : ''}>${book.title}</a>`
						: `<h3 class="favorites-item-title">${book.title}</h3>`,
					book.author ? `<p class="favorites-item-author">${book.author}</p>` : '',
					'</div>',
					`<button class="favorites-item-remove" data-book-id="${bookId}" aria-label="Quitar ${book.title} de favoritos" data-tooltip="Quitar" title="Quitar">`,
					'<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">',
					'<path d="M18 6L6 18" /><path d="M6 6l12 12" />',
					'</svg>',
					'</button>',
				].join('');
				favoritesList.appendChild(item);
			});

			favoritesList.querySelectorAll('.favorites-item-remove').forEach((removeBtn) => {
				removeBtn.addEventListener('click', (e) => {
					e.stopPropagation();
					const bookId = removeBtn.getAttribute('data-book-id');
					if (!bookId) return;
					toggleFavorite(bookId);
					syncFavoritesUI();
					updateFavoritesCount();
					renderFavoritesPanel();
				});
			});
		};

		syncFavoritesUI();
		updateFavoritesCount();

		document.querySelectorAll('[data-favorite]').forEach((btn) => {
			btn.addEventListener('click', (e) => {
				e.preventDefault();
				e.stopPropagation();
				const bookId = btn.getAttribute('data-book-id');
				if (!bookId) return;
				const wasFavorited = toggleFavorite(bookId);
				btn.setAttribute('data-favorite', wasFavorited.toString());
				const favLabel = wasFavorited ? 'Quitar de favoritos' : 'Marcar como favorito';
				const tipLabel = wasFavorited ? 'Quitar favorito' : 'Favorito';
				btn.setAttribute('aria-label', favLabel);
				btn.setAttribute('data-tooltip', tipLabel);
				btn.setAttribute('title', tipLabel);
				if (wasFavorited) {
					btn.classList.remove('animate-heartbeat');
					// Restart heartbeat when marking as favorite
					void (btn as HTMLElement).offsetWidth;
					btn.classList.add('animate-heartbeat');
					window.setTimeout(() => btn.classList.remove('animate-heartbeat'), 700);
				} else {
					btn.classList.add('animate-pop');
					window.setTimeout(() => btn.classList.remove('animate-pop'), 600);
				}
				updateFavoritesCount();
				if (favoritesPanel && !favoritesPanel.hasAttribute('hidden')) {
					renderFavoritesPanel();
				}
			});
		});

		showFavoritesBtn?.addEventListener('click', () => {
			favoritesPanel?.removeAttribute('hidden');
			renderFavoritesPanel();
		});
		favoritesClose?.addEventListener('click', () => {
			favoritesPanel?.setAttribute('hidden', '');
		});
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && favoritesPanel && !favoritesPanel.hasAttribute('hidden')) {
				favoritesPanel.setAttribute('hidden', '');
			}
		});
		document.addEventListener('favorites-changed', () => {
			syncFavoritesUI();
			updateFavoritesCount();
			if (favoritesPanel && !favoritesPanel.hasAttribute('hidden')) {
				renderFavoritesPanel();
			}
		});
	</script>
</Layout>

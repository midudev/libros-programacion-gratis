---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BookCard from '../components/BookCard.astro';
import Icon from '../components/Icon.astro';
import { librarySections, totalBooks, totalSections } from '../data/library';
import {
	createHomeStructuredData,
	getSectionPageEntry,
	getSectionPagePath,
	homeFaqs,
	homeMeta,
	siteConfig,
} from '../data/seo';
import { isMonochromeLogo, sectionLogoSources } from '../data/sectionLogos';

const sectionEntries = librarySections
	.map(getSectionPageEntry)
	.filter((entry) => entry.section.books.length > 0);

// Orden de lectura: de lo general a lo específico. Los grupos nuevos se añaden al final.
const preferredGroupOrder = [
	'Fundamentos',
	'Lenguajes',
	'Desarrollo web',
	'Frameworks',
	'Plataformas',
	'Herramientas',
	'Bases de datos',
	'IA y datos',
];
const groupNames = [
	...preferredGroupOrder,
	...new Set(sectionEntries.map((entry) => entry.section.group)),
].filter((name, index, all) => all.indexOf(name) === index);

const slugify = (value: string) =>
	value
		.normalize('NFD')
		.replace(/[̀-ͯ]/g, '')
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-+|-+$/g, '');

const groups = groupNames
	.map((name) => {
		const entries = sectionEntries.filter((entry) => entry.section.group === name);
		return {
			name,
			slug: slugify(name),
			entries,
			bookCount: entries.reduce((total, entry) => total + entry.section.books.length, 0),
		};
	})
	.filter((group) => group.entries.length > 0);

const topTopics = sectionEntries.slice(0, 12);
const suggestions = ['JavaScript', 'Python', 'React', 'Git', 'SQL', 'Algoritmos'];
const plural = (count: number, singular: string, pluralForm: string) =>
	`${count} ${count === 1 ? singular : pluralForm}`;

const structuredData = createHomeStructuredData();
---

<Layout
	title={homeMeta.title}
	description={homeMeta.description}
	keywords={homeMeta.keywords}
	structuredData={structuredData}
	canonical="/"
	image={siteConfig.defaultImage}
	imageAlt={siteConfig.defaultImageAlt}
>
	<div class="page">
		<SiteHeader variant="home" />

		<main>
			<section class="hero" aria-labelledby="hero-title">
				<p class="hero-eyebrow animate-fade-in animate-duration-500">
					<span><strong>{totalBooks}</strong> libros</span>
					<span aria-hidden="true">/</span>
					<span><strong>{totalSections}</strong> temas</span>
					<span class="hero-eyebrow-extra" aria-hidden="true">/</span>
					<span class="hero-eyebrow-extra">Web, PDF y EPUB</span>
					<span aria-hidden="true">/</span>
					<span><strong>0&nbsp;€</strong> siempre</span>
				</p>

				<h1 id="hero-title" class="hero-title animate-fade-in-up animate-duration-700">
					Libros <em>gratis</em> de programación en español
				</h1>

				<p class="hero-sub animate-fade-in-up animate-delay-100 animate-duration-700">
					Una biblioteca curada para leer online o descargar, sin registros ni muros de pago.
					De JavaScript y Python a algoritmos, Git o bases de datos.
				</p>

				<div class="hero-search animate-fade-in-up animate-delay-200 animate-duration-700" data-hero-search>
					<div class="search" data-search-box>
						<Icon name="search" size={20} />
						<input
							id="library-search"
							class="search-input"
							type="search"
							placeholder="Busca por título, autor o tema…"
							aria-label="Buscar libros por título, autor o tema"
							autocomplete="off"
							spellcheck="false"
							enterkeyhint="search"
							data-search-input
						/>
						<span class="search-aside">
							<span class="search-count" aria-live="polite" data-results-count>{totalBooks} libros</span>
							<button class="search-clear" type="button" data-reset-search hidden>Limpiar</button>
							<kbd class="kbd" title="Pulsa / para buscar" data-search-hotkey>/</kbd>
						</span>
					</div>

					<div class="hero-suggestions" data-hero-suggestions>
						<span>Prueba con</span>
						{suggestions.map((suggestion) => (
							<button class="suggestion" type="button" data-suggestion={suggestion}>
								{suggestion}
							</button>
						))}
					</div>
				</div>
			</section>

			<nav class="toc animate-fade-in-up animate-delay-300 animate-duration-700" id="temas" aria-labelledby="toc-title" data-toc>
				<div class="toc-head">
					<h2 class="toc-title" id="toc-title">Explora por tema</h2>
					<p class="toc-meta">{totalSections} temas en {groups.length} áreas</p>
				</div>
				<div class="toc-cols">
					{groups.map((group) => (
						<div class="toc-group">
							<h3 class="toc-group-title">{group.name}</h3>
							<ul class="toc-list">
								{group.entries.map((entry) => {
									const logo = sectionLogoSources(entry.section.slug)[0];
									const count = entry.section.books.length;

									return (
										<li>
											<a class="toc-link" href={`#${entry.section.slug}`}>
												{logo && (
													<img
														class:list={['section-logo', isMonochromeLogo(logo) && 'section-logo--mono']}
														src={logo}
														alt=""
														width="18"
														height="18"
														loading="lazy"
														decoding="async"
													/>
												)}
												<span class="toc-name">{entry.section.title}</span>
												<span class="toc-leader" aria-hidden="true"></span>
												<span class="toc-count">
													{count}
													<span class="sr-only"> {count === 1 ? 'libro' : 'libros'}</span>
												</span>
											</a>
										</li>
									);
								})}
							</ul>
						</div>
					))}
				</div>
			</nav>

			<div class="library" id="biblioteca">
				{groups.map((group) => (
					<section class="group" id={`area-${group.slug}`} aria-labelledby={`area-${group.slug}-title`} data-group-block>
						<header class="group-head">
							<h2 class="group-title" id={`area-${group.slug}-title`}>{group.name}</h2>
							<span class="group-meta">
								{plural(group.entries.length, 'tema', 'temas')} · {plural(group.bookCount, 'libro', 'libros')}
							</span>
						</header>

						{group.entries.map((entry) => {
							const { section } = entry;

							return (
								<section class="topic" id={section.slug} aria-labelledby={`${section.slug}-title`} data-topic>
									<header class="topic-head">
										<div class="topic-heading">
											<span class="topic-logos" aria-hidden="true">
												{sectionLogoSources(section.slug).map((logo) => (
													<img
														class:list={['section-logo', isMonochromeLogo(logo) && 'section-logo--mono']}
														src={logo}
														alt=""
														width="28"
														height="28"
														loading="lazy"
														decoding="async"
													/>
												))}
											</span>
											<h3 class="topic-title" id={`${section.slug}-title`}>{section.title}</h3>
											<span class="topic-count">{plural(section.books.length, 'libro', 'libros')}</span>
										</div>
										<a class="topic-more" href={getSectionPagePath(entry)} aria-label={`Ver página de libros de ${entry.displayName}`}>
											<span>Ver página</span>
											<Icon name="arrow-right" size={15} />
										</a>
									</header>
									<p class="topic-desc">{section.description}</p>

									<div class="book-grid">
										{section.books.map((book) => (
											<BookCard
												book={book}
												sectionTitle={section.title}
												sectionGroup={section.group}
												headingLevel="h4"
												showFavorite
											/>
										))}
									</div>
								</section>
							);
						})}
					</section>
				))}

				<div class="empty-state" hidden data-empty-state>
					<strong>Sin resultados</strong>
					<p>
						No hay libros que coincidan con «<span data-empty-query></span>». Prueba con otro término o
						<button class="text-link" type="button" data-reset-search>limpia la búsqueda</button>.
					</p>
				</div>
			</div>

			<section class="prose-section" aria-labelledby="about-library-title">
				<h2 id="about-library-title">Biblioteca de libros de programación gratis en español</h2>
				<div class="prose">
					<p>
						{siteConfig.name} reúne {totalBooks} recursos gratuitos de programación en español,
						organizados en {totalSections} temas: lenguajes, frameworks, bases de datos, herramientas
						y fundamentos. El objetivo es que puedas <strong>aprender a programar gratis</strong> con
						material en tu idioma, sin registros ni paywalls.
					</p>
					<p>
						Explora colecciones como{' '}
						{topTopics.map((entry, index) => (
							<>
								{index > 0 && (index === topTopics.length - 1 ? ' o ' : ', ')}
								<a href={getSectionPagePath(entry)}>libros gratis de {entry.displayName}</a>
							</>
						))}
						. Muchos títulos incluyen lectura online y descarga en PDF o EPUB.
					</p>
				</div>
			</section>

			<section class="prose-section" aria-labelledby="home-faq-title">
				<h2 id="home-faq-title">Preguntas frecuentes</h2>
				<div class="faq">
					{homeFaqs.map((faq) => (
						<details>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<SiteFooter showTopics />
	</div>

	<div class="sticky-search" data-sticky-toolbar hidden>
		<div class="sticky-search-inner">
			<a class="brand" href="/" aria-label="librosgratis.dev, ir al inicio">
				<span class="brand-mark"><Icon name="books" size={20} strokeWidth={1.5} /></span>
			</a>
			<div class="search" data-search-box>
				<Icon name="search" size={18} />
				<input
					id="library-search-sticky"
					class="search-input"
					type="search"
					placeholder="Buscar en la biblioteca…"
					aria-label="Buscar en la biblioteca"
					autocomplete="off"
					spellcheck="false"
					enterkeyhint="search"
					data-search-input
				/>
				<span class="search-aside">
					<span class="search-count" data-results-count>{totalBooks} libros</span>
					<button class="search-clear" type="button" data-reset-search hidden>Limpiar</button>
				</span>
			</div>
			<a class="nav-link" href="#temas" aria-label="Ir al índice de temas" data-tooltip="Temas">
				<Icon name="list" />
				<span class="nav-label">Temas</span>
			</a>
		</div>
	</div>

	<div class="favorites" id="favorites-panel" hidden>
		<div class="favorites-backdrop" data-favorites-close></div>
		<div class="favorites-sheet" role="dialog" aria-modal="true" aria-labelledby="favorites-title">
			<header class="favorites-head">
				<h2 id="favorites-title">Tus favoritos</h2>
				<button class="icon-btn" type="button" aria-label="Cerrar favoritos" data-favorites-close>
					<Icon name="x" />
				</button>
			</header>
			<div class="favorites-list" id="favorites-list"></div>
			<template id="favorites-remove-icon"><Icon name="x" size={16} /></template>
			<div class="favorites-empty" data-favorites-empty hidden>
				<Icon name="heart" size={28} />
				<p>Aún no has guardado libros. Pulsa el corazón de cualquier libro para tenerlo a mano aquí.</p>
			</div>
		</div>
	</div>

	<script>
		import { getFavorites, toggleFavorite } from '../scripts/favorites.ts';

		/* ── Búsqueda ── */

		const normalize = (value: string) =>
			value
				.normalize('NFD')
				.replace(/[̀-ͯ]/g, '')
				.toLowerCase()
				.trim();

		const pageRoot = document.querySelector('.page');
		const toc = document.querySelector<HTMLElement>('[data-toc]');
		const inputs = Array.from(document.querySelectorAll<HTMLInputElement>('[data-search-input]'));
		const counts = Array.from(document.querySelectorAll<HTMLElement>('[data-results-count]'));
		const clearButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-reset-search]'));
		const hotkeys = Array.from(document.querySelectorAll<HTMLElement>('[data-search-hotkey]'));
		const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-group-block]'));
		const emptyState = document.querySelector<HTMLElement>('[data-empty-state]');
		const emptyQuery = document.querySelector<HTMLElement>('[data-empty-query]');
		const heroInput = document.querySelector<HTMLInputElement>('#library-search');
		const stickyInput = document.querySelector<HTMLInputElement>('#library-search-sticky');

		let query = '';

		const syncQueryToUrl = () => {
			const url = new URL(window.location.href);
			if (query.trim()) url.searchParams.set('q', query.trim());
			else url.searchParams.delete('q');
			const next = `${url.pathname}${url.search}${url.hash}`;
			if (next !== `${window.location.pathname}${window.location.search}${window.location.hash}`) {
				window.history.replaceState({}, '', next);
			}
		};

		const applyFilters = () => {
			const terms = normalize(query).split(/\s+/).filter(Boolean);
			const hasQuery = terms.length > 0;
			let visibleBooks = 0;

			pageRoot?.classList.toggle('is-searching', hasQuery);
			toc?.toggleAttribute('hidden', hasQuery);

			for (const group of groups) {
				let groupVisible = 0;

				for (const topic of group.querySelectorAll<HTMLElement>('[data-topic]')) {
					let topicVisible = 0;

					for (const card of topic.querySelectorAll<HTMLElement>('.book')) {
						const haystack = card.dataset.search ?? '';
						const matches = !hasQuery || terms.every((term) => haystack.includes(term));
						card.hidden = !matches;
						if (matches) topicVisible += 1;
					}

					topic.hidden = topicVisible === 0;
					groupVisible += topicVisible;
				}

				group.hidden = groupVisible === 0;
				visibleBooks += groupVisible;
			}

			const label = `${visibleBooks} ${visibleBooks === 1 ? 'libro' : 'libros'}`;
			counts.forEach((count) => (count.textContent = label));
			clearButtons.forEach((button) => (button.hidden = !hasQuery && !button.closest('[data-empty-state]')));
			hotkeys.forEach((hotkey) => (hotkey.hidden = hasQuery));

			if (emptyState) emptyState.hidden = visibleBooks !== 0;
			if (emptyQuery) emptyQuery.textContent = query.trim();

			syncQueryToUrl();
		};

		const setQuery = (value: string, source?: HTMLInputElement) => {
			query = value;
			inputs.forEach((input) => {
				if (input !== source) input.value = value;
			});
			applyFilters();
		};

		inputs.forEach((input) => {
			input.addEventListener('input', () => setQuery(input.value, input));
			input.addEventListener('keydown', (event) => {
				if (event.key === 'Escape' && input.value) {
					event.preventDefault();
					setQuery('');
				}
			});
		});

		// Toda la caja del buscador enfoca su campo
		document.querySelectorAll<HTMLElement>('[data-search-box]').forEach((box) => {
			box.addEventListener('click', (event) => {
				if (event.target instanceof Element && event.target.closest('button')) return;
				box.querySelector('input')?.focus();
			});
		});

		clearButtons.forEach((button) => {
			button.addEventListener('click', () => {
				setQuery('');
				const inSticky = button.closest('[data-sticky-toolbar]');
				(inSticky ? stickyInput : heroInput)?.focus();
			});
		});

		document.querySelectorAll<HTMLButtonElement>('[data-suggestion]').forEach((button) => {
			button.addEventListener('click', () => {
				setQuery(button.dataset.suggestion ?? '');
				heroInput?.focus();
			});
		});

		// Atajo "/" para buscar
		document.addEventListener('keydown', (event) => {
			if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;
			const target = event.target;
			if (target instanceof HTMLElement && (target.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName))) return;
			event.preventDefault();
			const heroVisible = heroInput && heroInput.getBoundingClientRect().bottom > 80;
			(heroVisible ? heroInput : stickyInput)?.focus();
		});

		// Barra fija cuando el buscador principal sale de pantalla
		const stickyToolbar = document.querySelector<HTMLElement>('[data-sticky-toolbar]');
		const heroSearch = document.querySelector('[data-hero-search]');
		if (stickyToolbar && heroSearch && 'IntersectionObserver' in window) {
			new IntersectionObserver(([entry]) => {
				stickyToolbar.hidden = entry.isIntersecting;
			}).observe(heroSearch);
		}

		// Compatible con la SearchAction de Google: /?q=término
		const initialQuery = new URLSearchParams(window.location.search).get('q');
		if (initialQuery) setQuery(initialQuery);
		else applyFilters();

		/* ── Favoritos ── */

		const favoritesTrigger = document.querySelector<HTMLButtonElement>('#show-favorites');
		const favoritesPanel = document.querySelector<HTMLElement>('#favorites-panel');
		const favoritesList = document.querySelector<HTMLElement>('#favorites-list');
		const favoritesEmpty = document.querySelector<HTMLElement>('[data-favorites-empty]');
		const favoritesCount = document.querySelector<HTMLElement>('#favorites-count');
		const favoriteButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-favorite]'));

		type FavoriteBook = { title: string; author: string; href: string; external: boolean };
		const bookLookup = new Map<string, FavoriteBook>();

		favoriteButtons.forEach((button) => {
			const bookId = button.dataset.bookId;
			const card = button.closest('.book');
			if (!bookId || !card) return;
			const link = card.querySelector<HTMLAnchorElement>('.book-link');
			bookLookup.set(bookId, {
				title: card.querySelector('.book-title')?.textContent?.trim() ?? '',
				author: card.querySelector('.book-author')?.textContent?.trim() ?? '',
				href: link?.getAttribute('href') ?? '',
				external: link?.target === '_blank',
			});
		});

		const updateFavoritesCount = () => {
			if (!favoritesCount) return;
			const count = String(getFavorites().length);
			favoritesCount.textContent = count;
			favoritesCount.dataset.count = count;
		};

		const syncFavoriteButtons = () => {
			const favorites = getFavorites();
			favoriteButtons.forEach((button) => {
				const isFavorite = favorites.includes(button.dataset.bookId ?? '');
				const title = bookLookup.get(button.dataset.bookId ?? '')?.title ?? 'este libro';
				button.dataset.favorite = String(isFavorite);
				button.setAttribute('aria-pressed', String(isFavorite));
				button.setAttribute('aria-label', isFavorite ? `Quitar ${title} de favoritos` : `Guardar ${title} en favoritos`);
				button.dataset.tooltip = isFavorite ? 'Quitar' : 'Guardar';
			});
		};

		const removeIconTemplate = document.querySelector<HTMLTemplateElement>('#favorites-remove-icon');

		const renderFavoritesPanel = () => {
			if (!favoritesList || !favoritesEmpty) return;
			const favorites = getFavorites().filter((bookId) => bookLookup.has(bookId));
			favoritesList.replaceChildren();
			favoritesEmpty.hidden = favorites.length > 0;

			favorites.forEach((bookId) => {
				const book = bookLookup.get(bookId);
				if (!book) return;

				const item = document.createElement('div');
				item.className = 'favorites-item';

				const body = document.createElement('div');
				body.className = 'favorites-item-body';
				const title = document.createElement(book.href ? 'a' : 'p');
				title.className = 'favorites-item-title';
				title.textContent = book.title;
				if (title instanceof HTMLAnchorElement) {
					title.href = book.href;
					if (book.external) {
						title.target = '_blank';
						title.rel = 'nofollow noreferrer';
					}
				}
				body.append(title);

				if (book.author) {
					const author = document.createElement('p');
					author.className = 'favorites-item-author';
					author.textContent = book.author;
					body.append(author);
				}

				const remove = document.createElement('button');
				remove.type = 'button';
				remove.className = 'icon-btn';
				remove.setAttribute('aria-label', `Quitar ${book.title} de favoritos`);
				if (removeIconTemplate) remove.append(removeIconTemplate.content.cloneNode(true));
				remove.addEventListener('click', () => toggleFavorite(bookId));

				item.append(body, remove);
				favoritesList.append(item);
			});
		};

		const openFavorites = () => {
			if (!favoritesPanel) return;
			renderFavoritesPanel();
			favoritesPanel.hidden = false;
			document.documentElement.style.overflow = 'hidden';
			favoritesPanel.querySelector<HTMLButtonElement>('.favorites-head [data-favorites-close]')?.focus();
		};

		const closeFavorites = () => {
			if (!favoritesPanel || favoritesPanel.hidden) return;
			favoritesPanel.hidden = true;
			document.documentElement.style.overflow = '';
			favoritesTrigger?.focus();
		};

		favoriteButtons.forEach((button) => {
			button.addEventListener('click', () => {
				const bookId = button.dataset.bookId;
				if (!bookId) return;
				const isFavorite = toggleFavorite(bookId);
				const animation = isFavorite ? 'animate-heartbeat' : 'animate-pop';
				button.classList.remove('animate-heartbeat', 'animate-pop');
				void button.offsetWidth;
				button.classList.add(animation);
				window.setTimeout(() => button.classList.remove(animation), 700);
			});
		});

		favoritesTrigger?.addEventListener('click', openFavorites);
		favoritesPanel?.querySelectorAll('[data-favorites-close]').forEach((element) => {
			element.addEventListener('click', closeFavorites);
		});
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') closeFavorites();
		});

		// Mantiene el foco dentro del panel mientras está abierto
		favoritesPanel?.addEventListener('keydown', (event) => {
			if (event.key !== 'Tab') return;
			const focusable = Array.from(
				favoritesPanel.querySelectorAll<HTMLElement>('.favorites-sheet a[href], .favorites-sheet button'),
			);
			if (focusable.length === 0) return;
			const first = focusable[0];
			const last = focusable[focusable.length - 1];
			if (event.shiftKey && document.activeElement === first) {
				event.preventDefault();
				last.focus();
			} else if (!event.shiftKey && document.activeElement === last) {
				event.preventDefault();
				first.focus();
			}
		});

		document.addEventListener('favorites-changed', () => {
			syncFavoriteButtons();
			updateFavoritesCount();
			if (favoritesPanel && !favoritesPanel.hidden) renderFavoritesPanel();
		});

		syncFavoriteButtons();
		updateFavoritesCount();
	</script>
</Layout>

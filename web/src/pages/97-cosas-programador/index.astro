---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Icon from '../../components/Icon.astro';
import { programmer97ThingsAdvice, programmer97ThingsMeta } from '../../data/programmer97Things';
import { siteConfig } from '../../data/seo';

export const prerender = true;

const title = `97 cosas que todo programador debe saber en español | ${siteConfig.name}`;
const description =
	'Lee online y gratis los 97 consejos de «97 cosas que todo programador debe saber» (Kevlin Henney), traducidos al español. Cada consejo en su propia página HTML.';
const canonical = '/97-cosas-programador/';
const externalLinkRel = 'nofollow noreferrer';
const pageUrl = new URL(canonical, siteConfig.url).toString();
const keywords = [
	'97 cosas que todo programador debe saber',
	'97 things every programmer should know español',
	'consejos programación gratis',
	'Kevlin Henney español',
	'libros programación gratis',
];
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'BreadcrumbList',
			itemListElement: [
				{
					'@type': 'ListItem',
					position: 1,
					name: 'Libros gratis de programación',
					item: siteConfig.url,
				},
				{
					'@type': 'ListItem',
					position: 2,
					name: programmer97ThingsMeta.shortTitle,
					item: pageUrl,
				},
			],
		},
		{
			'@type': 'Book',
			name: programmer97ThingsMeta.title,
			editor: {
				'@type': 'Person',
				name: programmer97ThingsMeta.editor,
			},
			inLanguage: 'es',
			isAccessibleForFree: true,
			license: programmer97ThingsMeta.originalLicenseUrl,
			isBasedOn: programmer97ThingsMeta.originalSourceUrl,
			url: pageUrl,
			numberOfPages: programmer97ThingsAdvice.length,
			publisher: {
				'@type': 'Organization',
				name: siteConfig.name,
				url: siteConfig.url,
			},
		},
		{
			'@type': 'CollectionPage',
			name: title,
			description,
			url: pageUrl,
			inLanguage: 'es',
			isPartOf: {
				'@type': 'WebSite',
				name: siteConfig.name,
				url: siteConfig.url,
			},
			mainEntity: {
				'@type': 'ItemList',
				name: programmer97ThingsMeta.title,
				numberOfItems: programmer97ThingsAdvice.length,
				itemListElement: programmer97ThingsAdvice.map((advice) => ({
					'@type': 'ListItem',
					position: advice.number,
					url: new URL(`/97-cosas-programador/${advice.slug}/`, siteConfig.url).toString(),
					name: advice.title,
				})),
			},
		},
	],
};
---

<Layout
	title={title}
	description={description}
	canonical={canonical}
	structuredData={structuredData}
	image={siteConfig.defaultImage}
	imageAlt={programmer97ThingsMeta.shortTitle}
	ogType="article"
	keywords={keywords}
	dateModified={siteConfig.contentLastModified}
>
	<div class="page advice-book-page">
		<SiteHeader />

		<main>
			<nav class="breadcrumbs" aria-label="Migas de pan">
				<a href="/">Biblioteca</a>
				<span aria-hidden="true">/</span>
				<span>{programmer97ThingsMeta.shortTitle}</span>
			</nav>

			<section class="page-hero" aria-labelledby="advice-book-title">
				<div>
					<p class="eyebrow eyebrow--accent animate-fade-in animate-duration-500">Kevlin Henney y colaboradores</p>
					<h1 id="advice-book-title" class="animate-fade-in-up animate-duration-700">{programmer97ThingsMeta.title}</h1>
					<p class="page-hero-lead animate-fade-in-up animate-delay-100 animate-duration-700">
						Los {programmer97ThingsAdvice.length} consejos del libro, traducidos al español. Cada uno se lee
						en unos minutos y tiene su propia página.
					</p>
					<ul class="meta-list animate-fade-in-up animate-delay-200" aria-label="Resumen del libro">
						<li><strong>{programmer97ThingsAdvice.length}</strong> consejos</li>
						<li>Lectura online</li>
						<li>Licencia CC BY 3.0</li>
					</ul>
					<div class="actions page-hero-actions">
						<a class="btn btn-primary" href={`/97-cosas-programador/${programmer97ThingsAdvice[0].slug}/`}>
							<Icon name="read" />
							<span>Empezar a leer</span>
						</a>
					</div>
				</div>
			</section>

			<section class="section-block" aria-labelledby="advice-index-title">
				<div class="section-head">
					<h2 id="advice-index-title">Índice de consejos</h2>
					<span class="topic-count">{programmer97ThingsAdvice.length} páginas</span>
				</div>

				<div class="advice-index-grid">
					{programmer97ThingsAdvice.map((advice) => (
						<a class="advice-card" href={`/97-cosas-programador/${advice.slug}/`}>
							<span class="advice-card-number">{String(advice.number).padStart(2, '0')}</span>
							<span>
								<span class="advice-card-title">{advice.title}</span>
								<span class="advice-card-author">{advice.author}</span>
							</span>
						</a>
					))}
				</div>
			</section>

			<aside class="notice" aria-label="Atribución y licencia">
				<p>
					Traducción al español a partir de las contribuciones originales listadas en{' '}
					<a href={programmer97ThingsMeta.originalSourceUrl} target="_blank" rel={externalLinkRel}>
						Programmer 97-things
					</a>
					. La obra original indica: “{programmer97ThingsMeta.originalLicenseNotice}” (
					<a href={programmer97ThingsMeta.originalLicenseUrl} target="_blank" rel={externalLinkRel}>
						{programmer97ThingsMeta.originalLicenseName}
					</a>
					).
				</p>
			</aside>
		</main>

		<SiteFooter />
	</div>
</Layout>

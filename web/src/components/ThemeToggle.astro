---
import Icon from './Icon.astro';
---

<button
	class="theme-toggle nav-link"
	type="button"
	aria-label="Cambiar a modo oscuro"
	aria-pressed="false"
	data-tooltip="Cambiar tema"
>
	<Icon name="moon" class="moon-icon" />
	<Icon name="sun" class="sun-icon" />
	<span class="theme-toggle-label nav-label">Tema</span>
</button>

---
import Icon from './Icon.astro';
import { getLocalPdfBook, type LibraryBook } from '../data/library';

interface Props {
	book: LibraryBook;
	sectionTitle: string;
	sectionGroup: string;
	index?: number;
	headingLevel?: 'h3' | 'h4';
	showFavorite?: boolean;
}

const { book, sectionTitle, sectionGroup, index, headingLevel = 'h3', showFavorite = false } = Astro.props;
const Heading = headingLevel;

const isExternalHref = (href: string) => /^https?:\/\//.test(href);
const normalize = (value: string) =>
	value
		.normalize('NFD')
		.replace(/[̀-ͯ]/g, '')
		.toLowerCase();

// Portada generativa. Con posición, color y patrón avanzan en pasos coprimos con
// el tamaño de cada paleta: ninguna cubierta repite con sus vecinas en rejillas
// de 2, 3 o 4 columnas. Sin posición, salen del id del libro.
const COVER_HUES = [28, 55, 85, 125, 160, 200, 245, 285, 330];
const COVER_PATTERNS = 5;
const hashString = (value: string) => {
	let hash = 0x811c9dc5;
	for (let i = 0; i < value.length; i++) {
		hash ^= value.charCodeAt(i);
		hash = Math.imul(hash, 0x01000193) >>> 0;
	}
	return hash;
};
const coverSeed = hashString(index === undefined ? book.id : sectionTitle);
const coverStep = index ?? 0;
const coverHue = COVER_HUES[(coverSeed + coverStep * 4) % COVER_HUES.length];
const coverPattern = (coverSeed + coverStep * 2) % COVER_PATTERNS;
const coverNumber = index === undefined ? '' : String(index + 1).padStart(2, '0');

const pdfBook = getLocalPdfBook(book);
const hasHtmlVersion = Boolean(pdfBook && pdfBook.href !== pdfBook.pdfHref);
const primaryHref = hasHtmlVersion ? book.href : (pdfBook?.readerPath ?? book.href);
const opensInNewTab = isExternalHref(primaryHref);
const formats = pdfBook?.formats ?? book.formats ?? [];
const host = opensInNewTab ? new URL(primaryHref).hostname.replace(/^www\./, '') : '';
const searchText = normalize(`${book.title} ${book.author ?? ''} ${sectionTitle} ${sectionGroup}`);
---

<article
	class:list={['book', pdfBook ? 'is-local' : 'is-external']}
	data-search={searchText}
	data-pattern={coverPattern}
	style={`--cover-hue: ${coverHue}`}
>
	<div class="book-cover">
		<p class="book-kicker" aria-hidden="true">
			{sectionTitle}{coverNumber && ` · ${coverNumber}`}
		</p>
		<Heading class="book-title">
			{
				primaryHref ? (
					<a
						class="book-link"
						href={primaryHref}
						target={opensInNewTab ? '_blank' : undefined}
						rel={opensInNewTab ? 'nofollow noreferrer' : undefined}
					>
						{book.title}
					</a>
				) : (
					book.title
				)
			}
		</Heading>
		<span class="book-cover-art" aria-hidden="true"></span>
		{book.author && <p class="book-author">{book.author}</p>}

		{
			showFavorite && (
				<button
					class="book-fav"
					type="button"
					data-favorite="false"
					data-book-id={book.id}
					aria-label={`Guardar ${book.title} en favoritos`}
					aria-pressed="false"
					data-tooltip="Guardar"
				>
					<Icon name="heart" size={17} />
				</button>
			)
		}
	</div>

	<div class="book-foot">
		{
			pdfBook ? (
				<div class="book-actions" aria-label={`Opciones para ${book.title}`}>
					<span class="book-action is-primary" aria-hidden="true">
						<Icon name="read" size={15} />
						Leer
					</span>
					{hasHtmlVersion && (
						<a class="book-action" href={pdfBook.readerPath} aria-label={`Abrir ${book.title} en el visor PDF`}>
							<Icon name="file" size={15} />
							Visor
						</a>
					)}
					<a class="book-action" href={pdfBook.downloadPath} aria-label={`Descargar ${book.title} en PDF`}>
						<Icon name="download" size={15} />
						PDF
					</a>
					{pdfBook.epubHref && (
						<a
							class="book-action"
							href={pdfBook.epubHref}
							download={pdfBook.epubFileName}
							aria-label={`Descargar ${book.title} en EPUB`}
						>
							<Icon name="download" size={15} />
							EPUB
						</a>
					)}
				</div>
			) : (
				<>
					{formats.length > 0 && (
						<span class="book-formats">
							<span class="sr-only">Formatos: </span>
							{formats.join(' · ')}
						</span>
					)}
					{host && (
						<span class="book-source" aria-hidden="true">
							<span class="book-source-host">{host}</span>
							<Icon name="arrow-up-right" size={14} />
						</span>
					)}
				</>
			)
		}
	</div>

	{book.note && <p class="book-note">{book.note}</p>}
</article>
